# Application
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*

# MySQL (metadata / catalog store)
MYSQL_DSN=mysql+aiomysql://dgov:dgov@localhost:3306/dgov?charset=utf8mb4
DB_ECHO=false
# Create tables on startup (dev only, use alembic in production)
AUTO_CREATE_TABLES=true
# Seed the demonstration governance dataset on first startup
SEED_DEMO_DATA=true

# Metadata collection (test fixture API lives in tests/mock_metadata_api)
SEED_METADATA_SOURCE=true
MOCK_METADATA_API_URL=http://127.0.0.1:8100
METADATA_API_TIMEOUT=20
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=15

# Log retention: DB rows are pruned by age and row cap; file logs rotate by size
LOG_RETENTION_DAYS=30
LOG_MAX_ROWS=200000
LOG_DIR=logs
LOG_FILE_MAX_BYTES=52428800
LOG_BACKUP_COUNT=5
QUALITY_RESULT_RETENTION_DAYS=90

# Lineage insight pipeline + external agent endpoints
SECRET_KEY=dgov-dev-secret-change-me
LINEAGE_INSIGHT_ENABLED=true
LINEAGE_INSIGHT_AUTO_TRIGGER=true
LINEAGE_MAX_EDGES=2000
AGENT_TIMEOUT_MS=20000
AGENT_MAX_RETRIES=2
AGENT_RETRY_BACKOFF_MS=300
AGENT_DEFAULT_BASE_URL=internal://mock-agent

# Elasticsearch (semantic layer vector store)
ES_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ES_SEMANTIC_INDEX=dgov_semantic_assets
# Must match the dimension of vectors produced by your external embedding model
EMBEDDING_DIM=1024

# Neo4j (ontology graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dgov_password
NEO4J_DATABASE=neo4j
